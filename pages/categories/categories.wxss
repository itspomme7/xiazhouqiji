.headline{font-size:56rpx;color:#17332a;font-weight:750;margin-top:29rpx;}.subtitle{font-size:24rpx;color:#87918b;margin:9rpx 0 28rpx;}.search{height:90rpx;border-radius:60rpx;background:white;display:flex;align-items:center;gap:20rpx;padding:0 25rpx;color:#9aa39d;box-shadow:0 5rpx 20rpx rgba(0,0,0,.025);}.search image{width:35rpx;height:35rpx;}.cat-grid{display:grid;grid-template-columns:1fr 1fr;gap:17rpx;}.cat-card{min-height:138rpx;padding:22rpx 12rpx;display:flex;align-items:center;gap:14rpx;position:relative;}.cat-icon{width:72rpx;height:72rpx;border-radius:18rpx;background:#eaf2e8;display:flex;align-items:center;justify-content:center;}.cat-icon image{width:42rpx;height:42rpx;}.cat-name{font-size:25rpx;color:#253c30;font-weight:650;display:block;max-width:168rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.cat-count{font-size:20rpx;color:#a0a9a1;display:block;margin-top:9rpx;}.right{width:21rpx;height:21rpx;margin-left:auto;opacity:.4;}.mini-list{display:flex;flex-direction:column;gap:16rpx;}.mini{padding:24rpx;}.mini-title{font-size:26rpx;font-weight:650;}.mini-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:23rpx;color:#7d8a83;line-height:1.6;margin:12rpx 0;}.mini-foot{font-size:20rpx;color:#96a398;}
